<header class="hero sub">
  <div class="hbg" role="img" aria-label="A plane coming in to land at Funchal airport along the coast of Madeira" style="background-image:url('../assets/journal/plane-landing-funchal-airport-madeira-coast.jpg');background-image:image-set(url('../assets/journal/plane-landing-funchal-airport-madeira-coast.webp') type('image/webp'),url('../assets/journal/plane-landing-funchal-airport-madeira-coast.jpg') type('image/jpeg'))"></div>
