<header class="hero sub">
  <div class="hbg" role="img" aria-label="A guest jumping feet first off the side of a motor boat into deep blue sea" style="background-image:url('../assets/journal/guest-jumping-feet-first-from-boat-faja-dos-padres-madeira.jpg');background-image:image-set(url('../assets/journal/guest-jumping-feet-first-from-boat-faja-dos-padres-madeira.webp') type('image/webp'),url('../assets/journal/guest-jumping-feet-first-from-boat-faja-dos-padres-madeira.jpg') type('image/jpeg'))"></div>
