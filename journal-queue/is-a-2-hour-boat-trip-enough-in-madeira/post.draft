<header class="hero sub">
  <div class="hbg" role="img" aria-label="Drone view of a white boat drawing a curved wake as it turns below Cabo Girão" style="background-image:url('../assets/journal/drone-boat-wake-turning-under-cabo-girao-golden-hour-madeira.jpg');background-image:image-set(url('../assets/journal/drone-boat-wake-turning-under-cabo-girao-golden-hour-madeira.webp') type('image/webp'),url('../assets/journal/drone-boat-wake-turning-under-cabo-girao-golden-hour-madeira.jpg') type('image/jpeg'))"></div>
