<header class="hero sub">
  <div class="hbg" role="img" aria-label="A small white motor boat passing a large three deck motor yacht moored in Funchal harbour" style="background-image:url('../assets/journal/small-private-boat-passing-large-motor-yacht-funchal-madeira.jpg');background-image:image-set(url('../assets/journal/small-private-boat-passing-large-motor-yacht-funchal-madeira.webp') type('image/webp'),url('../assets/journal/small-private-boat-passing-large-motor-yacht-funchal-madeira.jpg') type('image/jpeg'))"></div>
