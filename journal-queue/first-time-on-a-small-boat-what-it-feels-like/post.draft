<header class="hero sub">
  <div class="hbg" role="img" aria-label="View from the back of the boat over the white wake towards Funchal on a bright morning" style="background-image:url('../assets/journal/first-time-passenger-view-from-stern-wake-funchal-madeira.jpg');background-image:image-set(url('../assets/journal/first-time-passenger-view-from-stern-wake-funchal-madeira.webp') type('image/webp'),url('../assets/journal/first-time-passenger-view-from-stern-wake-funchal-madeira.jpg') type('image/jpeg'))"></div>
