<header class="hero sub">
  <div class="hbg" role="img" aria-label="The long golden sand beach of Porto Santo in soft morning light beside a calm turquoise sea" style="background-image:url('../assets/journal/porto-santo-golden-beach-early-morning-madeira.jpg');background-image:image-set(url('../assets/journal/porto-santo-golden-beach-early-morning-madeira.webp') type('image/webp'),url('../assets/journal/porto-santo-golden-beach-early-morning-madeira.jpg') type('image/jpeg'))"></div>
