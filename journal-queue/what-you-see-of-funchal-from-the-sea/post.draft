<header class="hero sub">
  <div class="hbg" role="img" aria-label="Funchal's lights climbing the hills at dusk, seen from the stern of a boat returning" style="background-image:url('../assets/journal/funchal-amphitheatre-city-lights-from-the-boat-at-dusk-madeira.jpg');background-image:image-set(url('../assets/journal/funchal-amphitheatre-city-lights-from-the-boat-at-dusk-madeira.webp') type('image/webp'),url('../assets/journal/funchal-amphitheatre-city-lights-from-the-boat-at-dusk-madeira.jpg') type('image/jpeg'))"></div>
  <div class="hov"></div>
