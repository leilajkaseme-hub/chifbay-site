<header class="hero sub">
  <div class="hbg" role="img" aria-label="Rounded grey pebbles and a breaking wave on Praia Formosa in Funchal at early evening" style="background-image:url('../assets/journal/praia-formosa-pebbles-and-wave-early-evening-funchal-madeira.jpg');background-image:image-set(url('../assets/journal/praia-formosa-pebbles-and-wave-early-evening-funchal-madeira.webp') type('image/webp'),url('../assets/journal/praia-formosa-pebbles-and-wave-early-evening-funchal-madeira.jpg') type('image/jpeg'))"></div>
