<header class="hero sub">
  <div class="hbg" role="img" aria-label="Wet pebbles and exposed rock ledges at low tide on the beach at Ponta do Sol" style="background-image:url('../assets/journal/low-tide-pebble-beach-ponta-do-sol-madeira.jpg');background-image:image-set(url('../assets/journal/low-tide-pebble-beach-ponta-do-sol-madeira.webp') type('image/webp'),url('../assets/journal/low-tide-pebble-beach-ponta-do-sol-madeira.jpg') type('image/jpeg'))"></div>
