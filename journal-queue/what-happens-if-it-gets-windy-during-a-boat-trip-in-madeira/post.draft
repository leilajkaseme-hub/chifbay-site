<header class="hero sub">
  <div class="hbg" role="img" aria-label="Drone view of a white motor boat heading home past Ponta da Cruz on a breezy afternoon" style="background-image:url('../assets/journal/boat-heading-home-past-ponta-da-cruz-breezy-afternoon-madeira.jpg');background-image:image-set(url('../assets/journal/boat-heading-home-past-ponta-da-cruz-breezy-afternoon-madeira.webp') type('image/webp'),url('../assets/journal/boat-heading-home-past-ponta-da-cruz-breezy-afternoon-madeira.jpg') type('image/jpeg'))"></div>
