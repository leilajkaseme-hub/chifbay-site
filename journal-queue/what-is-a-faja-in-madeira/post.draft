<header class="hero sub">
  <div class="hbg" role="img" aria-label="View from the Rancho cable car down to the fajã fields and the sea under Cabo Girão" style="background-image:url('../assets/journal/rancho-cable-car-descending-to-faja-fields-cabo-girao-madeira.jpg');background-image:image-set(url('../assets/journal/rancho-cable-car-descending-to-faja-fields-cabo-girao-madeira.webp') type('image/webp'),url('../assets/journal/rancho-cable-car-descending-to-faja-fields-cabo-girao-madeira.jpg') type('image/jpeg'))"></div>
