<header class="hero sub">
  <div class="hbg" role="img" aria-label="Two people seen from behind walking along the seafront promenade towards Marina do Funchal" style="background-image:url('../assets/journal/couple-walking-promenade-towards-funchal-marina-at-dusk-madeira.jpg');background-image:image-set(url('../assets/journal/couple-walking-promenade-towards-funchal-marina-at-dusk-madeira.webp') type('image/webp'),url('../assets/journal/couple-walking-promenade-towards-funchal-marina-at-dusk-madeira.jpg') type('image/jpeg'))"></div>
