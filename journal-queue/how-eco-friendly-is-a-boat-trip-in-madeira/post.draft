  <div class="hbg" role="img" aria-label="A loggerhead turtle at the surface while a small boat waits well back" style="background-image:url('../assets/journal/turtle-at-the-surface-boat-holding-back-madeira.jpg');background-image:image-set(url('../assets/journal/turtle-at-the-surface-boat-holding-back-madeira.webp') type('image/webp'),url('../assets/journal/turtle-at-the-surface-boat-holding-back-madeira.jpg') type('image/jpeg'))"></div>
