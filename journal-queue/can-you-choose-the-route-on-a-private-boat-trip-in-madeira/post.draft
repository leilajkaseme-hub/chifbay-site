<header class="hero sub">
  <div class="hbg" role="img" aria-label="A motor boat seen from above making a wide curving turn off Ponta do Sol" style="background-image:url('../assets/journal/boat-turning-wide-wake-off-ponta-do-sol-madeira.jpg');background-image:image-set(url('../assets/journal/boat-turning-wide-wake-off-ponta-do-sol-madeira.webp') type('image/webp'),url('../assets/journal/boat-turning-wide-wake-off-ponta-do-sol-madeira.jpg') type('image/jpeg'))"></div>
