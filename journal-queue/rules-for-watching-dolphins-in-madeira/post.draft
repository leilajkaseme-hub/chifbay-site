<header class="hero sub">
  <div class="hbg" role="img" aria-label="Small group of dolphins surfacing at a respectful distance from a private boat off Madeira" style="background-image:url('../assets/journal/dolphins-at-a-distance-from-a-small-boat-madeira.jpg');background-image:image-set(url('../assets/journal/dolphins-at-a-distance-from-a-small-boat-madeira.webp') type('image/webp'),url('../assets/journal/dolphins-at-a-distance-from-a-small-boat-madeira.jpg') type('image/jpeg'))"></div>
