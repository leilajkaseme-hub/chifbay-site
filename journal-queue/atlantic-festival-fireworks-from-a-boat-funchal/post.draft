<header class="hero sub">
  <div class="hbg" role="img" aria-label="Fireworks bursting over Funchal harbour on a June night, reflected in the sea, small boats in silhouette" style="background-image:url('../assets/journal/atlantic-festival-fireworks-over-funchal-harbour-in-june-from-the-water-madeira.jpg');background-image:image-set(url('../assets/journal/atlantic-festival-fireworks-over-funchal-harbour-in-june-from-the-water-madeira.webp') type('image/webp'),url('../assets/journal/atlantic-festival-fireworks-over-funchal-harbour-in-june-from-the-water-madeira.jpg') type('image/jpeg'))"></div>
