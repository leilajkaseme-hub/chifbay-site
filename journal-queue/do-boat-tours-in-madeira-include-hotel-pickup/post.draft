<header class="hero sub">
  <div class="hbg" role="img" aria-label="View from Santa Catarina park over palm trees to Funchal harbour, the marina and a cruise ship" style="background-image:url('../assets/journal/santa-catarina-park-view-down-to-funchal-harbour-madeira.jpg');background-image:image-set(url('../assets/journal/santa-catarina-park-view-down-to-funchal-harbour-madeira.webp') type('image/webp'),url('../assets/journal/santa-catarina-park-view-down-to-funchal-harbour-madeira.jpg') type('image/jpeg'))"></div>
  <div class="hov"></div>
