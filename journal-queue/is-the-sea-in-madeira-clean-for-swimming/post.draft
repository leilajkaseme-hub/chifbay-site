<header class="hero sub">
  <div class="hbg" role="img" aria-label="Swimmer in deep clear blue water looking towards the pebble shore of Fajã dos Padres" style="background-image:url('../assets/journal/swimmer-in-clean-blue-water-faja-dos-padres-madeira.jpg');background-image:image-set(url('../assets/journal/swimmer-in-clean-blue-water-faja-dos-padres-madeira.webp') type('image/webp'),url('../assets/journal/swimmer-in-clean-blue-water-faja-dos-padres-madeira.jpg') type('image/jpeg'))"></div>
