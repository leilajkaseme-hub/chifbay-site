<header class="hero sub">
  <div class="hbg" role="img" aria-label="Guest in a long-sleeved wetsuit top lowering into the sea off Ribeira Brava in winter" style="background-image:url('../assets/journal/winter-swim-from-the-stern-off-ribeira-brava-madeira.jpg');background-image:image-set(url('../assets/journal/winter-swim-from-the-stern-off-ribeira-brava-madeira.webp') type('image/webp'),url('../assets/journal/winter-swim-from-the-stern-off-ribeira-brava-madeira.jpg') type('image/jpeg'))"></div>
