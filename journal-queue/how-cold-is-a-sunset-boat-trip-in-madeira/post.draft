<header class="hero sub">
  <div class="hbg" role="img" aria-label="Two guests pulling on jackets on a boat deck just after sunset off Ribeira Brava" style="background-image:url('../assets/journal/guests-pulling-on-jackets-after-sunset-off-ribeira-brava-madeira.jpg');background-image:image-set(url('../assets/journal/guests-pulling-on-jackets-after-sunset-off-ribeira-brava-madeira.webp') type('image/webp'),url('../assets/journal/guests-pulling-on-jackets-after-sunset-off-ribeira-brava-madeira.jpg') type('image/jpeg'))"></div>
