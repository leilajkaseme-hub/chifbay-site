<header class="hero sub">
  <div class="hbg" role="img" aria-label="Drone view of Calheta marina and its golden sand beach behind breakwaters on Madeira's southwest coast" style="background-image:url('../assets/journal/calheta-marina-and-sand-beach-from-above-madeira.jpg');background-image:image-set(url('../assets/journal/calheta-marina-and-sand-beach-from-above-madeira.webp') type('image/webp'),url('../assets/journal/calheta-marina-and-sand-beach-from-above-madeira.jpg') type('image/jpeg'))"></div>
