<header class="hero sub">
  <div class="hbg" role="img" aria-label="A passenger ship lying at anchor in Funchal bay at dawn, a small launch heading to the harbour" style="background-image:url('../assets/journal/passenger-ship-at-anchor-in-funchal-bay-dawn-madeira.jpg');background-image:image-set(url('../assets/journal/passenger-ship-at-anchor-in-funchal-bay-dawn-madeira.webp') type('image/webp'),url('../assets/journal/passenger-ship-at-anchor-in-funchal-bay-dawn-madeira.jpg') type('image/jpeg'))"></div>
