<header class="hero sub">
  <div class="hbg" role="img" aria-label="A motor boat seen from directly above with five small guests on board and swimming nearby" style="background-image:url('../assets/journal/drone-above-boat-with-five-guests-off-ribeira-brava-madeira.jpg');background-image:image-set(url('../assets/journal/drone-above-boat-with-five-guests-off-ribeira-brava-madeira.webp') type('image/webp'),url('../assets/journal/drone-above-boat-with-five-guests-off-ribeira-brava-madeira.jpg') type('image/jpeg'))"></div>
