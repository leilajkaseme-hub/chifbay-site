<header class="hero sub">
  <div class="hbg" role="img" aria-label="A passenger plane low over the sea on its way to Madeira airport, seen from a boat deck" style="background-image:url('../assets/journal/plane-approach-over-funchal-bay-from-the-boat-madeira.jpg');background-image:image-set(url('../assets/journal/plane-approach-over-funchal-bay-from-the-boat-madeira.webp') type('image/webp'),url('../assets/journal/plane-approach-over-funchal-bay-from-the-boat-madeira.jpg') type('image/jpeg'))"></div>
