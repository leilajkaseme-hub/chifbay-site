    <h1 class="rv in" style="font-size:clamp(2.2rem,5vw,4rem);max-width:20ch">Top 10 Day Trips from Funchal</h1>
    <div class="artmeta rv in d1"><span>18 October 2026</span><span>5 min read</span><span>Funchal · Madeira</span></div>
  </div>
