<header class="hero sub">
  <div class="hbg" role="img" aria-label="The bow of a white motor boat lifting over a gentle Atlantic swell off Funchal in the morning" style="background-image:url('../assets/journal/bow-of-a-boat-over-gentle-atlantic-swell-funchal-morning-madeira.jpg');background-image:image-set(url('../assets/journal/bow-of-a-boat-over-gentle-atlantic-swell-funchal-morning-madeira.webp') type('image/webp'),url('../assets/journal/bow-of-a-boat-over-gentle-atlantic-swell-funchal-morning-madeira.jpg') type('image/jpeg'))"></div>
