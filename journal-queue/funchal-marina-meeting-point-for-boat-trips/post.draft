<header class="hero sub">
  <div class="hbg" role="img" aria-label="Marina do Funchal and its pontoons seen from the seafront promenade, with palm trees and moored boats" style="background-image:url('../assets/journal/marina-do-funchal-pontoons-seen-from-avenida-do-mar-madeira.jpg');background-image:image-set(url('../assets/journal/marina-do-funchal-pontoons-seen-from-avenida-do-mar-madeira.webp') type('image/webp'),url('../assets/journal/marina-do-funchal-pontoons-seen-from-avenida-do-mar-madeira.jpg') type('image/jpeg'))"></div>
