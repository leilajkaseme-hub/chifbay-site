<header class="hero sub">
  <div class="hbg" role="img" aria-label="A common tern hovering over the sea below the brown cliffs of Ponta do Garajau" style="background-image:url('../assets/journal/common-tern-hovering-over-the-sea-below-garajau-cliffs-madeira.jpg');background-image:image-set(url('../assets/journal/common-tern-hovering-over-the-sea-below-garajau-cliffs-madeira.webp') type('image/webp'),url('../assets/journal/common-tern-hovering-over-the-sea-below-garajau-cliffs-madeira.jpg') type('image/jpeg'))"></div>
