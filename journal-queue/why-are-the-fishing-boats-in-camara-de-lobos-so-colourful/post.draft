<header class="hero sub">
  <div class="hbg" role="img" aria-label="Painted fishing boats on dark pebbles and in the water at Câmara de Lobos, seen from directly above" style="background-image:url('../assets/journal/camara-de-lobos-painted-boats-from-directly-above-winter-morning-madeira.jpg');background-image:image-set(url('../assets/journal/camara-de-lobos-painted-boats-from-directly-above-winter-morning-madeira.webp') type('image/webp'),url('../assets/journal/camara-de-lobos-painted-boats-from-directly-above-winter-morning-madeira.jpg') type('image/jpeg'))"></div>
