<header class="hero sub">
  <div class="hbg" role="img" aria-label="A walker seen from behind on a levada path along a green mountainside, morning mist below" style="background-image:url('../assets/journal/levada-path-laurel-forest-morning-mist-madeira.jpg');background-image:image-set(url('../assets/journal/levada-path-laurel-forest-morning-mist-madeira.webp') type('image/webp'),url('../assets/journal/levada-path-laurel-forest-morning-mist-madeira.jpg') type('image/jpeg'))"></div>
