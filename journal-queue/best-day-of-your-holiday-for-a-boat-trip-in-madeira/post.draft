<header class="hero sub">
  <div class="hbg" role="img" aria-label="A coffee cup and a folded map on a balcony table above a calm Funchal bay in early morning" style="background-image:url('../assets/journal/hotel-balcony-morning-coffee-above-funchal-bay-madeira.jpg');background-image:image-set(url('../assets/journal/hotel-balcony-morning-coffee-above-funchal-bay-madeira.webp') type('image/webp'),url('../assets/journal/hotel-balcony-morning-coffee-above-funchal-bay-madeira.jpg') type('image/jpeg'))"></div>
