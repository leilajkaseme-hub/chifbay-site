<header class="hero sub">
  <div class="hbg" role="img" aria-label="A phone in a clear waterproof pouch on a lanyard, resting on a grey boat cushion" style="background-image:url('../assets/journal/phone-on-lanyard-in-waterproof-pouch-on-boat-cushion-cabo-girao-madeira.jpg');background-image:image-set(url('../assets/journal/phone-on-lanyard-in-waterproof-pouch-on-boat-cushion-cabo-girao-madeira.webp') type('image/webp'),url('../assets/journal/phone-on-lanyard-in-waterproof-pouch-on-boat-cushion-cabo-girao-madeira.jpg') type('image/jpeg'))"></div>
