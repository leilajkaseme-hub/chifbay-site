<header class="hero sub">
  <div class="hbg" role="img" aria-label="Heels, glass and spray sunscreen set apart from sandals, a towel and sun cream on a pontoon" style="background-image:url('../assets/journal/flat-lay-what-to-leave-behind-on-funchal-pontoon-madeira.jpg');background-image:image-set(url('../assets/journal/flat-lay-what-to-leave-behind-on-funchal-pontoon-madeira.webp') type('image/webp'),url('../assets/journal/flat-lay-what-to-leave-behind-on-funchal-pontoon-madeira.jpg') type('image/jpeg'))"></div>
