<header class="hero sub">
  <div class="hbg" role="img" aria-label="A path lined with flowers in a Madeira garden" style="background-image:url('../assets/journal/madeira-botanical-garden-flowers-path.jpg');background-image:image-set(url('../assets/journal/madeira-botanical-garden-flowers-path.webp') type('image/webp'),url('../assets/journal/madeira-botanical-garden-flowers-path.jpg') type('image/jpeg'))"></div>
