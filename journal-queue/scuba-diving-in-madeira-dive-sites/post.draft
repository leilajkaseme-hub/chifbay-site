<header class="hero sub">
  <div class="hbg" role="img" aria-label="Two divers with tanks walking down worn steps into a calm sea on Madeira's south coast" style="background-image:url('../assets/journal/two-divers-walking-into-the-sea-at-a-shore-entry-madeira.jpg');background-image:image-set(url('../assets/journal/two-divers-walking-into-the-sea-at-a-shore-entry-madeira.webp') type('image/webp'),url('../assets/journal/two-divers-walking-into-the-sea-at-a-shore-entry-madeira.jpg') type('image/jpeg'))"></div>
