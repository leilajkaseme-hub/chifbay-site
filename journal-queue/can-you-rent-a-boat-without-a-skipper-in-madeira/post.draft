<header class="hero sub">
  <div class="hbg" role="img" aria-label="A skipper at the helm seen from behind, steering a motor boat along Madeira's south coast cliffs" style="background-image:url('../assets/journal/skipper-at-the-helm-south-coast-cliffs-madeira.jpg');background-image:image-set(url('../assets/journal/skipper-at-the-helm-south-coast-cliffs-madeira.webp') type('image/webp'),url('../assets/journal/skipper-at-the-helm-south-coast-cliffs-madeira.jpg') type('image/jpeg'))"></div>
