<header class="hero sub">
  <div class="hbg" role="img" aria-label="Câmara de Lobos bay seen from a boat, colourful fishing boats, chapel and houses on the rock" style="background-image:url('../assets/journal/camara-de-lobos-bay-fishing-boats-from-the-sea-madeira.jpg');background-image:image-set(url('../assets/journal/camara-de-lobos-bay-fishing-boats-from-the-sea-madeira.webp') type('image/webp'),url('../assets/journal/camara-de-lobos-bay-fishing-boats-from-the-sea-madeira.jpg') type('image/jpeg'))"></div>
