<header class="hero sub">
  <div class="hbg" role="img" aria-label="The tail of a sperm whale rising above calm blue sea, with Madeira's mountains faint behind" style="background-image:url('../assets/journal/sperm-whale-tail-fluke-off-the-coast-madeira.jpg');background-image:image-set(url('../assets/journal/sperm-whale-tail-fluke-off-the-coast-madeira.webp') type('image/webp'),url('../assets/journal/sperm-whale-tail-fluke-off-the-coast-madeira.jpg') type('image/jpeg'))"></div>
