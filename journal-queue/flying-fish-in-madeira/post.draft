<header class="hero sub">
  <div class="hbg" role="img" aria-label="An Atlantic flying fish gliding low over deep blue water beside a boat's wake" style="background-image:url('../assets/journal/atlantic-flying-fish-gliding-over-blue-sea-beside-boat-madeira.jpg');background-image:image-set(url('../assets/journal/atlantic-flying-fish-gliding-over-blue-sea-beside-boat-madeira.webp') type('image/webp'),url('../assets/journal/atlantic-flying-fish-gliding-over-blue-sea-beside-boat-madeira.jpg') type('image/jpeg'))"></div>
