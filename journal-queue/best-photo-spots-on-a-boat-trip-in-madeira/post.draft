<header class="hero sub">
  <div class="hbg" role="img" aria-label="A guest seen from behind photographing the coast near Ribeira Brava from the bow in late light" style="background-image:url('../assets/journal/guest-photographing-ribeira-brava-coast-from-the-bow-golden-light-madeira.jpg');background-image:image-set(url('../assets/journal/guest-photographing-ribeira-brava-coast-from-the-bow-golden-light-madeira.webp') type('image/webp'),url('../assets/journal/guest-photographing-ribeira-brava-coast-from-the-bow-golden-light-madeira.jpg') type('image/jpeg'))"></div>
