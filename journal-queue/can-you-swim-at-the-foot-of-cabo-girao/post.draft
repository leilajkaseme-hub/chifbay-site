<header class="hero sub">
  <div class="hbg" role="img" aria-label="Boulder beach and fallen rock at the foot of Cabo Girão, seen from the water" style="background-image:url('../assets/journal/boulder-beach-at-the-foot-of-cabo-girao-from-the-water-madeira.jpg');background-image:image-set(url('../assets/journal/boulder-beach-at-the-foot-of-cabo-girao-from-the-water-madeira.webp') type('image/webp'),url('../assets/journal/boulder-beach-at-the-foot-of-cabo-girao-from-the-water-madeira.jpg') type('image/jpeg'))"></div>
