<header class="hero sub">
  <div class="hbg" role="img" aria-label="Two sea kayaks pulled up on a dark pebble beach below cliffs east of Funchal" style="background-image:url('../assets/journal/two-sea-kayaks-on-a-pebble-beach-east-of-funchal-madeira.jpg');background-image:image-set(url('../assets/journal/two-sea-kayaks-on-a-pebble-beach-east-of-funchal-madeira.webp') type('image/webp'),url('../assets/journal/two-sea-kayaks-on-a-pebble-beach-east-of-funchal-madeira.jpg') type('image/jpeg'))"></div>
