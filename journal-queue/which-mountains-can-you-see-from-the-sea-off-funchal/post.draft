<header class="hero sub">
  <div class="hbg" role="img" aria-label="Funchal's slopes rising to a clear mountain ridge with a small white dome, seen from the sea" style="background-image:url('../assets/journal/funchal-slope-to-central-mountain-ridge-early-morning-from-the-sea-madeira.jpg');background-image:image-set(url('../assets/journal/funchal-slope-to-central-mountain-ridge-early-morning-from-the-sea-madeira.webp') type('image/webp'),url('../assets/journal/funchal-slope-to-central-mountain-ridge-early-morning-from-the-sea-madeira.jpg') type('image/jpeg'))"></div>
