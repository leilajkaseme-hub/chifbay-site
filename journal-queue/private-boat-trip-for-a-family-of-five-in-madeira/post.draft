<header class="hero sub">
  <div class="hbg" role="img" aria-label="A family of five seen from behind on the boat deck, heading towards Ribeira Brava" style="background-image:url('../assets/journal/family-of-five-on-deck-heading-to-ribeira-brava-madeira.jpg');background-image:image-set(url('../assets/journal/family-of-five-on-deck-heading-to-ribeira-brava-madeira.webp') type('image/webp'),url('../assets/journal/family-of-five-on-deck-heading-to-ribeira-brava-madeira.jpg') type('image/jpeg'))"></div>
