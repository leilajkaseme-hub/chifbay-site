<header class="hero sub">
  <div class="hbg" role="img" aria-label="Glasses of poncha and local wine on a boat deck table, Madeira cliffs behind in midday sun" style="background-image:url('../assets/journal/drinks-on-deck-south-coast-cliffs-madeira.jpg');background-image:image-set(url('../assets/journal/drinks-on-deck-south-coast-cliffs-madeira.webp') type('image/webp'),url('../assets/journal/drinks-on-deck-south-coast-cliffs-madeira.jpg') type('image/jpeg'))"></div>
