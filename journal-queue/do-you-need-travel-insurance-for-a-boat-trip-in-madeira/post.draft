<header class="hero sub">
  <div class="hbg" role="img" aria-label="A passport and a phone in a clear waterproof pouch on a café table by Funchal's seafront" style="background-image:url('../assets/journal/passport-and-phone-in-waterproof-pouch-cafe-table-funchal-seafront-madeira.jpg');background-image:image-set(url('../assets/journal/passport-and-phone-in-waterproof-pouch-cafe-table-funchal-seafront-madeira.webp') type('image/webp'),url('../assets/journal/passport-and-phone-in-waterproof-pouch-cafe-table-funchal-seafront-madeira.jpg') type('image/jpeg'))"></div>
