<header class="hero sub">
  <div class="hbg" role="img" aria-label="A loggerhead sea turtle surfacing to breathe on the blue sea off Madeira" style="background-image:url('../assets/journal/loggerhead-turtle-surfacing-blue-sea-madeira-hero.jpg');background-image:image-set(url('../assets/journal/loggerhead-turtle-surfacing-blue-sea-madeira-hero.webp') type('image/webp'),url('../assets/journal/loggerhead-turtle-surfacing-blue-sea-madeira-hero.jpg') type('image/jpeg'))"></div>
