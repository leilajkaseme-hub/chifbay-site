<header class="hero sub">
  <div class="hbg" role="img" aria-label="Machico bay on Madeira's east coast seen from the sea in early morning light" style="background-image:url('../assets/journal/machico-bay-east-coast-from-the-sea-early-morning-madeira.jpg');background-image:image-set(url('../assets/journal/machico-bay-east-coast-from-the-sea-early-morning-madeira.webp') type('image/webp'),url('../assets/journal/machico-bay-east-coast-from-the-sea-early-morning-madeira.jpg') type('image/jpeg'))"></div>
