<header class="hero sub">
  <div class="hbg" role="img" aria-label="Black sea urchins in the cracks of dark volcanic rock under shallow clear water" style="background-image:url('../assets/journal/sea-urchins-at-a-rocky-sea-entry-madeira.jpg');background-image:image-set(url('../assets/journal/sea-urchins-at-a-rocky-sea-entry-madeira.webp') type('image/webp'),url('../assets/journal/sea-urchins-at-a-rocky-sea-entry-madeira.jpg') type('image/jpeg'))"></div>
