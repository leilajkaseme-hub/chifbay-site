  <div class="hbg" role="img" aria-label="A coffee and a phone on a hotel balcony table above a ruffled sea in Funchal" style="background-image:url('../assets/journal/hotel-balcony-coffee-windy-sea-lido-funchal-madeira.jpg');background-image:image-set(url('../assets/journal/hotel-balcony-coffee-windy-sea-lido-funchal-madeira.webp') type('image/webp'),url('../assets/journal/hotel-balcony-coffee-windy-sea-lido-funchal-madeira.jpg') type('image/jpeg'))"></div>
