<header class="hero sub">
  <div class="hbg" role="img" aria-label="The long, low Desertas Islands on the south-eastern horizon, seen from a boat off Funchal" style="background-image:url('../assets/journal/desertas-islands-on-the-horizon-late-afternoon-from-boat-off-funchal-madeira.jpg');background-image:image-set(url('../assets/journal/desertas-islands-on-the-horizon-late-afternoon-from-boat-off-funchal-madeira.webp') type('image/webp'),url('../assets/journal/desertas-islands-on-the-horizon-late-afternoon-from-boat-off-funchal-madeira.jpg') type('image/jpeg'))"></div>
