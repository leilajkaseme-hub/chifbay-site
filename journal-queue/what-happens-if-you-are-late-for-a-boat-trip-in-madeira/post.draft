<header class="hero sub">
  <div class="hbg" role="img" aria-label="A couple seen from behind walking quickly along the Funchal seafront towards the marina" style="background-image:url('../assets/journal/couple-hurrying-along-avenida-do-mar-to-funchal-marina-madeira.jpg');background-image:image-set(url('../assets/journal/couple-hurrying-along-avenida-do-mar-to-funchal-marina-madeira.webp') type('image/webp'),url('../assets/journal/couple-hurrying-along-avenida-do-mar-to-funchal-marina-madeira.jpg') type('image/jpeg'))"></div>
