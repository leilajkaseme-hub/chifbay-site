<header class="hero sub">
  <div class="hbg" role="img" aria-label="Solo traveller seen from behind sitting alone near the front of a boat off Ribeira Brava" style="background-image:url('../assets/journal/solo-traveller-alone-on-bow-near-ribeira-brava-madeira.jpg');background-image:image-set(url('../assets/journal/solo-traveller-alone-on-bow-near-ribeira-brava-madeira.webp') type('image/webp'),url('../assets/journal/solo-traveller-alone-on-bow-near-ribeira-brava-madeira.jpg') type('image/jpeg'))"></div>
