<header class="hero sub">
  <div class="hbg" role="img" aria-label="Two guests in light jackets on a boat deck looking at the Desertas islands on a winter morning" style="background-image:url('../assets/journal/winter-morning-deck-view-desertas-islands-glassy-sea-madeira.jpg');background-image:image-set(url('../assets/journal/winter-morning-deck-view-desertas-islands-glassy-sea-madeira.webp') type('image/webp'),url('../assets/journal/winter-morning-deck-view-desertas-islands-glassy-sea-madeira.jpg') type('image/jpeg'))"></div>
