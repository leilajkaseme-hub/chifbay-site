<header class="hero sub">
  <div class="hbg" role="img" aria-label="A pebble beach with turquoise water seen from above on the Madeira coast" style="background-image:url('../assets/journal/madeira-pebble-beach-turquoise-water-from-above.jpg');background-image:image-set(url('../assets/journal/madeira-pebble-beach-turquoise-water-from-above.webp') type('image/webp'),url('../assets/journal/madeira-pebble-beach-turquoise-water-from-above.jpg') type('image/jpeg'))"></div>
