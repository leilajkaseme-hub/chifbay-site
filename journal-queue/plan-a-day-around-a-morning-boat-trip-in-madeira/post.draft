<header class="hero sub">
  <div class="hbg" role="img" aria-label="Two visitors on the Cabo Girão glass skywalk looking down at the sea and small fields far below" style="background-image:url('../assets/journal/cabo-girao-skywalk-looking-down-at-the-sea-madeira.jpg');background-image:image-set(url('../assets/journal/cabo-girao-skywalk-looking-down-at-the-sea-madeira.webp') type('image/webp'),url('../assets/journal/cabo-girao-skywalk-looking-down-at-the-sea-madeira.jpg') type('image/jpeg'))"></div>
